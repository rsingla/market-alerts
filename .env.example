# ===== NOTIFICATION CHANNELS (Choose one or more) =====

# Email (Brevo) - EASIEST & RECOMMENDED
# Get API key from: https://app.brevo.com (FREE - 300 emails/day)
BREVO_API_KEY=your_brevo_api_key
SENDER_EMAIL=alerts@marketalerts.com
SENDER_NAME=Market Alerts
RECIPIENT_EMAIL=your_email@example.com

# Telegram - VERY EASY (Just need bot token and chat ID)
# 1. Message @BotFather on Telegram
# 2. Create bot with /newbot
# 3. Get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Signal - REQUIRES SIGNAL-CLI INSTALLATION
# Install: brew install signal-cli (macOS)
# Register your number first with signal-cli
SIGNAL_SENDER_NUMBER=+1234567890
SIGNAL_RECIPIENT_NUMBER=+1234567890
SIGNAL_CLI_PATH=signal-cli

# WhatsApp (Twilio) - COMPLEX SETUP
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+1234567890

# WhatsApp Web - REQUIRES LOGGED-IN BROWSER
# Uses browser automation via pywhatkit
# Phone number format: +1234567890 (with country code, no spaces)
WHATSAPP_WEB_RECIPIENT=+1234567890
WHATSAPP_WEB_WAIT_TIME=15
WHATSAPP_WEB_CLOSE_TAB=true

# ===== FINANCIAL DATA APIs =====
# Alpha Vantage (FREE - 500 calls/day)
# Get key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# News API (FREE - 1000 requests/day)
# Get key from: https://newsapi.org/register
NEWS_API_KEY=your_news_api_key

# Finnhub (OPTIONAL - FREE - 60 calls/minute)
# Get key from: https://finnhub.io
FINNHUB_API_KEY=your_finnhub_key

# Yahoo Finance (no key needed - enabled by default)
USE_YFINANCE=true

# ===== ALERT SETTINGS =====
# Stocks to monitor (comma-separated)
WATCHLIST=AAPL,GOOGL,MSFT,TSLA,NVDA,SPY,QQQ,DIA

# Price change thresholds (%)
SMALL_MOVE_THRESHOLD=1.0
MEDIUM_MOVE_THRESHOLD=3.0
LARGE_MOVE_THRESHOLD=5.0

# Volume spike threshold (multiple of average)
VOLUME_SPIKE_THRESHOLD=2.0

# ===== SCHEDULER SETTINGS =====
# Check interval in minutes (during market hours)
CHECK_INTERVAL_MINUTES=60

# Only send alerts during market hours
MARKET_HOURS_ONLY=true

# Market hours (EST)
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=16
MARKET_CLOSE_MINUTE=0

# ===== NEWS SETTINGS =====
# Keywords for important news (comma-separated)
NEWS_KEYWORDS=earnings,fed,rate,gdp,jobs,inflation,unemployment,fomc

# Maximum news items per alert
MAX_NEWS_ITEMS=3

# ===== CACHE SETTINGS =====
# Cache duration in seconds (5 minutes)
CACHE_DURATION=300

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FILE=logs/market_alerts.log
